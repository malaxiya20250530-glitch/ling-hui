<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主渐变背景 -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="108"
                android:endX="108"
                android:endY="0"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="0.5" android:color="#A855F7" />
                <item android:offset="1.0" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底部光晕 -->
    <path
        android:pathData="M20,80 C40,100 80,100 100,70 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="80"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="1.0" android:color="#4C1D95" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
